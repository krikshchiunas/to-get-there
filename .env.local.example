# Copy to .env.local. Values come from the Supabase dashboard (Project settings -> API)
# or from `supabase start` when running the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only. Never expose to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Stage 1-3 render every screen from lib/mock. Flip to "false" once Supabase
# queries replace the mock reads (see docs/ROADMAP.md).
NEXT_PUBLIC_USE_MOCKS=true
