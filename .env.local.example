# Copy to .env.local. Values come from the Supabase dashboard (Project settings -> API)
# or from `supabase start` when running the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Public address of the site, used in e-mail links and the identity-check return URL.
# On Vercel it falls back to the production domain; locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# "true" renders every screen from lib/mock without a database.
NEXT_PUBLIC_USE_MOCKS=false

# ── Server-only. Never expose to the browser, never commit real values. ──

# Supabase secret key (sb_secret_...; the legacy service_role key also works
# for the webhook). Used by the Stripe webhook to record the verification
# result, and — only with SUPABASE_AUTH_IP_FORWARDING — to forward the
# visitor's IP to Supabase Auth rate limits (lib/supabase/auth.ts). Never
# used for data queries.
SUPABASE_SECRET_KEY=

# "true" sends Sb-Forwarded-For with the visitor's IP on sign-in, sign-up and
# e-mail requests, so Auth rate limits count people, not our server. Needs a
# new sb_secret_ key above and Authentication -> Rate Limits -> IP Address
# Forwarding enabled in Supabase. Only behind a proxy that sets
# X-Forwarded-For itself (Vercel does). docs/AUTH.md, "Лимиты".
SUPABASE_AUTH_IP_FORWARDING=

# Stripe Identity (Dashboard -> Developers). Without all three the
# verification screen says the check is not connected yet.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<site>/api/webhooks/stripe, events
# identity.verification_session.{processing,verified,requires_input,canceled}
STRIPE_WEBHOOK_SECRET=
